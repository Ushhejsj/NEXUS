QMainWindow {
    background-color: #09090F;
    color: #F4F0FA;
    font-family: "Segoe UI";
    font-size: 13px;
}

QWidget {
    color: #F4F0FA;
    font-family: "Segoe UI";
}

QFrame#Panel, QFrame#Sidebar, QFrame#RightPanel, QFrame#CorePanel {
    background-color: #11111B;
    border: 1px solid #302B40;
    border-radius: 18px;
}

QPushButton {
    background-color: #191925;
    color: #F4F0FA;
    border: 1px solid #302B40;
    border-radius: 10px;
    padding: 9px 14px;
}

QPushButton:hover {
    background-color: #222231;
    border-color: #B995E8;
}

QPushButton:pressed {
    background-color: #382A4B;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background-color: #11111B;
    color: #F4F0FA;
    border: 1px solid #302B40;
    border-radius: 9px;
    padding: 8px;
    selection-background-color: #B995E8;
}

QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #514663;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #B995E8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
